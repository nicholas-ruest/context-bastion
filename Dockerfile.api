FROM rust:1.99-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p cb-api
FROM debian:bookworm-slim
RUN useradd -r -u 10001 bastion
COPY --from=build /src/target/release/cb-api /usr/local/bin/cb-api
USER bastion
ENV BASTION_BIND=0.0.0.0:8787 BASTION_DATA_DIR=/data
EXPOSE 8787
CMD ["cb-api"]
